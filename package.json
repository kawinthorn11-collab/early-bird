{
  "name": "early-bird-english",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "validate": "node scripts/validate.mjs && node scripts/check-courses.mjs",
    "generate:audio": "node scripts/generate-audio.mjs",
    "add:questions": "node scripts/add-questions.mjs",
    "check:answers": "node scripts/check-answers.mjs",
    "test": "node scripts/run-tests.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/chonburi": "^5.3.0",
    "@fontsource/prompt": "^5.3.0",
    "@fontsource/sarabun": "^5.3.0",
    "canvas-confetti": "^1.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
